# ============================================================
#  finetune-observability — Monitoring plane (.env.example)
# ============================================================

PLATFORM_NETWORK_NAME=finetune-prod
PREFECT_SERVER_API_AUTH_STRING=<prefect-user>:<strong-prefect-password>

# Grafana admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<strong-password>

# Alertmanager config file path (absolute path on host)
ALERTMANAGER_CONFIG_PATH=/srv/finetune/observability/alertmanager.yml

# Observability configuration directory (relative to manifest or absolute)
OBS_CONFIG_DIR=../observability

# Prefect exporter script directory
EXPORTER_DIR=../observability/prefect-exporter
