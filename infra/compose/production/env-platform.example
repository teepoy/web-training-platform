# ============================================================
#  finetune-platform — App plane (.env.example)
# ============================================================

# Runtime profile. Use pre-release for the test environment and prod only for
# the production environment.
APP_CONFIG_PROFILE=prod
PLATFORM_NETWORK_NAME=finetune-prod
FRONTEND_URL=https://finetune.example.com
JWT_SECRET_KEY=<random-secret-at-least-32-bytes>
# Required only when oauth.enabled=true in the selected API profile.
OAUTH_STATE_SECRET=

# Compose memory limits (platform services and one-shot ops)
PREFECT_SERVER_MEMORY=4g
API_MEMORY=8g
SC_DATA_PROVIDER_WORKER_COUNT=4
SC_DATA_PROVIDER_CONTAINER_MEMORY_LIMIT_MB=6144
WEB_MEMORY=1g
CPU_WORKER_MEMORY=8g
GPU_WORKER_MEMORY=16g
SC_UPSTREAM_MEMORY=8g
SC_UPSTREAM_IMAGE_SOURCE_PROFILE=sc_upstream
IMAGE_PARSER_MEMORY=32g
PLATFORM_PREPARE_MEMORY=2g

# API database
DATABASE_URL=postgresql+asyncpg://finetune:<password>@postgres:5432/finetune

# Prefect
PREFECT_DATABASE_URL=postgresql+asyncpg://finetune:<password>@postgres:5432/prefect
PREFECT_UI_URL=https://prefect.example.com
PREFECT_SERVER_API_AUTH_STRING=<prefect-user>:<strong-prefect-password>

# Optional operator-console links shown only under Admin > Infrastructure.
# Configure only HTTPS endpoints protected by an authentication proxy or VPN.
OPERATOR_PREFECT_UI_URL=https://prefect-admin.example.com
OPERATOR_MINIO_CONSOLE_URL=https://minio-admin.example.com

# MinIO / S3 (all buckets)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=<access-key>
MINIO_SECRET_KEY=<secret-key>
MINIO_BUCKET=finetune-artifacts
SC_PATCH_S3_ENDPOINT=minio:9000
SC_PATCH_S3_ACCESS_KEY=<access-key>
SC_PATCH_S3_SECRET_KEY=<secret-key>
SC_PATCH_S3_BUCKET=sc-patch-images
SC_REVIEW_S3_ENDPOINT=minio:9000
SC_REVIEW_S3_ACCESS_KEY=<access-key>
SC_REVIEW_S3_SECRET_KEY=<secret-key>
SC_REVIEW_S3_BUCKET=sc-review-images

# Label Studio (shared with stateful project)
POSTGRES_USER=finetune
POSTGRES_PASSWORD=<strong-password>
LABEL_STUDIO_USERNAME=<admin-email>
LABEL_STUDIO_PASSWORD=<strong-password>
LABEL_STUDIO_API_KEY=<token>
LABEL_STUDIO_EXTERNAL_URL=https://labels.example.com
LABEL_STUDIO_DATABASE_URL=postgresql+asyncpg://finetune:<password>@postgres:5432/labelstudio

# Images — immutable tags required
FINETUNE_API_IMAGE=registry.example.com/finetune-api:<release>
FINETUNE_WEB_IMAGE=registry.example.com/finetune-web:<release>
FINETUNE_CPU_WORKER_IMAGE=registry.example.com/finetune-cpu-worker:<release>
FINETUNE_GPU_WORKER_IMAGE=registry.example.com/finetune-gpu-worker:<release>
IMAGE_PARSER_IMAGE=registry.example.com/image-parser:<release>
SC_UPSTREAM_IMAGE=registry.example.com/sc-upstream:<release>

# Upstream DB (sc-upstream)
UPSTREAM_DB_URL=sqlite:////data/wafer_inspection.db
ZIPS_DB_URL=sqlite:////data/inspection_zips.db
SC_UPSTREAM_CACHE_SIZE_LIMIT_BYTES=10737418240
SC_UPSTREAM_RAW_CACHE_CLEANUP_INTERVAL_SECONDS=7200
REDIS_URL=redis://redis:6379/0

# Image parser local file cache
IMAGE_PARSER_CACHE_SIZE_MB=32768
IMAGE_PARSER_CACHE_TTL=10m
IMAGE_PARSER_CACHE_CLEANUP_INTERVAL=5m
IMAGE_PARSER_CACHE_MAX_BYTES=34359738368
IMAGE_SOURCE_PROFILES_JSON={"sc_upstream":{"provider":"sc_upstream"}}
SC_COMPAT_IMAGE_SOURCE_PROFILE=sc_upstream
SC_TRAINING_IMAGE_PARSER_CACHE_SIZE_MB=256

# LLM (optional)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen/qwen-max
