# ============================================================
#  finetune-stateful — Data plane (.env.example)
# ============================================================

PLATFORM_NETWORK_NAME=finetune-prod

# Compose memory limits
POSTGRES_MEMORY=8g
MINIO_MEMORY=4g
REDIS_MEMORY=2g
LABEL_STUDIO_MEMORY=4g

# PostgreSQL credentials (shared with all DB consumers)
POSTGRES_USER=finetune
POSTGRES_PASSWORD=<strong-password>

# MinIO S3 credentials
MINIO_ROOT_USER=<access-key>
MINIO_ROOT_PASSWORD=<strong-secret-key>

# Path to init-scripts directory (relative to compose.stateful.yaml or absolute)
INIT_SCRIPTS_DIR=../init-scripts

# Label Studio image (immutable tag required)
LABEL_STUDIO_IMAGE=heartexlabs/label-studio:<immutable-tag>
LABEL_STUDIO_USERNAME=<admin-email>
LABEL_STUDIO_PASSWORD=<strong-password>
LABEL_STUDIO_API_KEY=<token>
