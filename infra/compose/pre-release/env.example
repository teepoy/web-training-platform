# Local pre-release acceptance environment.
#
# Copy this file to infra/compose/pre-release/.env before running the
# `*-pre-release-local` Make targets. Deployed pre-release uses the production
# manifests and separate `/srv/finetune-pre-release/*/.env` files. All ports in
# this local overlay are bound to 127.0.0.1.

APP_CONFIG_PROFILE=pre-release
PLATFORM_NETWORK_NAME=finetune-pre-release-local

# Host endpoints exposed by the local acceptance overlays.
FRONTEND_URL=http://127.0.0.1:15173
PREFECT_UI_URL=http://127.0.0.1:14200
LABEL_STUDIO_EXTERNAL_URL=http://127.0.0.1:18080

# Operator console links intentionally stay hidden in local acceptance because
# the loopback endpoints below are HTTP, while the production UI requires HTTPS.
OPERATOR_PREFECT_UI_URL=
OPERATOR_MINIO_CONSOLE_URL=

# API and orchestration secrets.
JWT_SECRET_KEY=pre-release-local-signing-key-change-before-shared-host
OAUTH_STATE_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_CUSTOM_CLIENT_ID=
OAUTH_CUSTOM_CLIENT_SECRET=
PREFECT_SERVER_API_AUTH_STRING=pre-release:pre-release-local-prefect-password

# PostgreSQL.
POSTGRES_USER=finetune
POSTGRES_PASSWORD=pre-release-local-postgres-password
DATABASE_URL=postgresql+asyncpg://finetune:pre-release-local-postgres-password@postgres:5432/finetune
PREFECT_DATABASE_URL=postgresql+asyncpg://finetune:pre-release-local-postgres-password@postgres:5432/prefect

# MinIO / S3.
MINIO_ROOT_USER=pre-release-minio
MINIO_ROOT_PASSWORD=pre-release-local-minio-password
MINIO_ENDPOINT=minio:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=pre-release-minio
MINIO_SECRET_KEY=pre-release-local-minio-password
IMAGE_PARSER_DISPLAY_CACHE_MAX_BYTES=4294967296
IMAGE_PARSER_PREDICTION_CACHE_MAX_BYTES=25769803776
IMAGE_PARSER_TRAINING_CACHE_MAX_BYTES=4294967296
IMAGE_PARSER_EXPORT_CACHE_MAX_BYTES=4294967296

# Label Studio.
LABEL_STUDIO_IMAGE=heartexlabs/label-studio:1.23.0
LABEL_STUDIO_USERNAME=admin@pre-release.local
LABEL_STUDIO_PASSWORD=pre-release-local-label-studio-password
LABEL_STUDIO_API_KEY=pre-release-local-label-studio-token
LABEL_STUDIO_DATABASE_URL=postgresql+asyncpg://finetune:pre-release-local-postgres-password@postgres:5432/labelstudio

# Production-built application image names. Make overrides the tags with the
# current git revision (and "-dirty" when appropriate).
FINETUNE_API_IMAGE=web-training-platform/api:pre-release
FINETUNE_WEB_IMAGE=web-training-platform/web:pre-release
FINETUNE_CPU_WORKER_IMAGE=web-training-platform/cpu-worker:pre-release
FINETUNE_GPU_WORKER_IMAGE=web-training-platform/gpu-worker:pre-release
SC_UPSTREAM_IMAGE=web-training-platform/sc-upstream:pre-release
IMAGE_PARSER_IMAGE=web-training-platform/image-parser:pre-release

# Compose memory limits. These feed deploy.resources.limits.memory in the
# production manifests; keep them explicit when sizing an acceptance host.
POSTGRES_MEMORY=8g
MINIO_MEMORY=4g
REDIS_MEMORY=2g
LABEL_STUDIO_MEMORY=4g
PREFECT_SERVER_MEMORY=4g
API_MEMORY=8g
WEB_MEMORY=1g
CPU_WORKER_MEMORY=8g
GPU_WORKER_MEMORY=16g
SC_UPSTREAM_MEMORY=8g
IMAGE_PARSER_MEMORY=32g
PLATFORM_PREPARE_MEMORY=2g

# SC runtime.
UPSTREAM_DB_URL=sqlite:////data/wafer_inspection.db
ZIPS_DB_URL=sqlite:////data/inspection_zips.db
REDIS_URL=redis://redis:6379/0

# Local-only host bindings.
PRE_RELEASE_BIND_HOST=127.0.0.1
PRE_RELEASE_POSTGRES_PORT=15432
PRE_RELEASE_MINIO_PORT=19000
PRE_RELEASE_MINIO_CONSOLE_PORT=19001
PRE_RELEASE_REDIS_PORT=16379
PRE_RELEASE_LABEL_STUDIO_PORT=18080
PRE_RELEASE_PREFECT_PORT=14200
PRE_RELEASE_API_PORT=18000
PRE_RELEASE_SC_DATA_PROVIDER_PORT=18001
PRE_RELEASE_WEB_PORT=15173
PRE_RELEASE_SC_GRPC_PORT=19091
PRE_RELEASE_SC_FLIGHT_PORT=19093
PRE_RELEASE_IMAGE_PARSER_HTTP_PORT=18090
PRE_RELEASE_IMAGE_PARSER_GRPC_PORT=19092

# Build mirrors are optional.
UV_INDEX_URL=
PIP_INDEX_URL=
NPM_CONFIG_REGISTRY=

# Optional LLM integration.
LLM_BASE_URL=
LLM_API_KEY=
REDIS_PASSWORD=

# The path is resolved relative to the production compose file.
INIT_SCRIPTS_DIR=../init-scripts
