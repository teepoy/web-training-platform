{
  "id": null,
  "uid": "finetune-gpu-runtime",
  "title": "GPU Runtime",
  "tags": ["finetune"],
  "schemaVersion": 36,
  "version": 1,
  "time": {"from": "now-6h", "to": "now"},
  "refresh": "30s",
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "GPU Worker Health",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {"color": "red", "value": null},
            {"color": "green", "value": 1}
          ]
        }
      },
      "targets": [
        {
          "expr": "up{job=\"gpu-worker\"}",
          "legendFormat": "gpu-worker",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "GPU Memory Utilization %",
      "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 70},
            {"color": "red", "value": 90}
          ]
        },
        "unit": "percent"
      },
      "targets": [
        {
          "expr": "100 * (DCGM_FI_DEV_FB_USED or vector(0)) / ((DCGM_FI_DEV_FB_USED + DCGM_FI_DEV_FB_FREE) or vector(1))",
          "legendFormat": "GPU FB Memory %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "GPU Utilization %",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 70},
            {"color": "red", "value": 90}
          ]
        },
        "unit": "percent"
      },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_GPU_UTIL or vector(0)",
          "legendFormat": "GPU Util %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Container Restarts (15m)",
      "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 1},
            {"color": "red", "value": 3}
          ]
        }
      },
      "targets": [
        {
          "expr": "increase(kube_pod_container_status_restarts_total{container=\"gpu-worker\"}[15m]) or increase(container_start_time_seconds{name=~\".*gpu-worker.*\"}[15m]) or vector(0)",
          "legendFormat": "Restarts",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "GPU Worker Request Rate",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {"lineWidth": 1, "fillOpacity": 10}
        }
      },
      "options": {"tooltip": {"mode": "multi"}},
      "targets": [
        {
          "expr": "rate(http_requests_total{job=\"gpu-worker\"}[2m])",
          "legendFormat": "{{method}} {{handler}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "GPU Worker Request Latency (p50/p95/p99)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"lineWidth": 1, "fillOpacity": 10}
        }
      },
      "options": {"tooltip": {"mode": "multi"}},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{job=\"gpu-worker\"}[2m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"gpu-worker\"}[2m]))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{job=\"gpu-worker\"}[2m]))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "GPU Memory (Used / Free)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {"lineWidth": 1, "fillOpacity": 10}
        }
      },
      "options": {"tooltip": {"mode": "multi"}},
      "targets": [
        {
          "expr": "(DCGM_FI_DEV_FB_USED * 1048576) or vector(0)",
          "legendFormat": "Used",
          "refId": "A"
        },
        {
          "expr": "(DCGM_FI_DEV_FB_FREE * 1048576) or vector(0)",
          "legendFormat": "Free",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "GPU Worker CPU / Memory",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"lineWidth": 1, "fillOpacity": 10}
        }
      },
      "options": {"tooltip": {"mode": "multi"}},
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{name=~\".*gpu-worker.*\"}[2m])",
          "legendFormat": "CPU cores",
          "refId": "A"
        },
        {
          "expr": "container_memory_usage_bytes{name=~\".*gpu-worker.*\"}",
          "legendFormat": "Memory bytes",
          "refId": "B"
        }
      ]
    }
  ]
}
