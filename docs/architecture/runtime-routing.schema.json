{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://web-training-platform.local/schemas/runtime-routing.schema.json",
  "title": "Runtime Routing Environment Overrides",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "training_routes": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/deploymentOverride" }
    },
    "prediction_routes": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/deploymentOverride" }
    },
    "train_and_predict_routes": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/deploymentOverride" }
    },
    "materialization_routes": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/deploymentOverride" }
    }
  },
  "$defs": {
    "deploymentOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deployment": { "type": "string", "minLength": 1 },
        "resource_profile": { "enum": ["cpu", "gpu"] },
        "owner": { "enum": ["local_compat", "external"] },
        "code_version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
