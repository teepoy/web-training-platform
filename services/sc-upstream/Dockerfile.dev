FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.11.22 /uv /uvx /usr/local/bin/

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY apps/api/pyproject.toml apps/api/pyproject.toml
COPY libs/protos/pyproject.toml libs/protos/pyproject.toml
COPY libs/ml/pyproject.toml libs/ml/pyproject.toml
COPY services/sc-upstream/pyproject.toml services/sc-upstream/pyproject.toml
COPY libs/protos/ libs/protos/
COPY services/sc-upstream/src services/sc-upstream/src

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --package sc-upstream --no-dev

COPY services/sc-upstream/dev_adapters/upstream_mock/src /app/services/sc-upstream/dev_adapters/upstream_mock/src

ENV PYTHONPATH=/app/services/sc-upstream/dev_adapters/upstream_mock/src
ENV GRPC_PORT=9091
ENV FLIGHT_PORT=9093

EXPOSE 9091 9093

WORKDIR /app/services/sc-upstream
CMD ["/app/.venv/bin/python", "-m", "sc_upstream.server"]
