{
  "name": "online-finetune-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.5.0",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "test:web": "pnpm --filter web test:all",
    "test:registrations": "pnpm --filter web test:registrations",
    "test:widget-sdk": "pnpm --filter @platform/widget-sdk test",
    "test:web-ui": "pnpm --filter @platform/web-ui test",
    "generate:api-contract": "pnpm --filter @platform/api-contract generate",
    "typecheck:api-contract": "pnpm --filter @platform/api-contract typecheck",
    "storybook": "pnpm --filter web storybook",
    "build-storybook": "pnpm --filter web build-storybook"
  }
}
