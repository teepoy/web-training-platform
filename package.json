{
  "name": "online-finetune-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "test:web": "pnpm --filter web test:all",
    "test:registrations": "pnpm --filter web test:registrations",
    "format": "prettier --write apps/web packages docs infra package.json pnpm-workspace.yaml",
    "format:check": "prettier --check apps/web packages docs infra package.json pnpm-workspace.yaml",
    "storybook": "pnpm --filter web storybook",
    "build-storybook": "pnpm --filter web build-storybook"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.70.0",
    "prettier": "^3.8.3"
  }
}
