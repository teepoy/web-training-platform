      "max_source_files": 260,
      "max_nodes": 5000,
      "overlays": {
        "tests": {
          "roots": [
            "apps/api/app/modules/datasets/tests",
            "apps/api/app/modules/storage/tests",
            "apps/api/app/modules/dataset_collections/tests"
