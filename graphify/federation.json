            "apps/web/src/features/training/**/*.spec.ts",
            "apps/web/src/features/prediction/**/*.spec.ts",
            "apps/web/src/features/task_tracker/**/*.spec.ts"
          ]
        }
      }
    },
    {
      "name": "sc-domain",
      "description": "SC inspection, review sampling, image parsing, upstream access, and SC ML.",
      "aliases": [
        "sc",
        "inspection",
        "wafer",
        "review sampling",
        "image parser",
