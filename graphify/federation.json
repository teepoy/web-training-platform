{
  "schema_version": 1,
  "graphify_version": "0.8.34",
  "root_context": "architecture-contracts",
  "output_dir": "graphify-out/contexts",
  "semantic_overlay": "graphify/architecture-contracts.semantic.json",
  "bridge_overlay": "graphify/architecture-bridges.json",
  "noise_labels": ["BaseModel", "BaseSettings", "T", "storage()"],
  "required_directed_paths": [
    {
      "name": "dataset storage to artifact commit",
      "context": "architecture-contracts",
      "nodes": [
        "contract_dataset_storage_agg",
        "contract_data_plane_manifest",
        "contract_runtime_callable",
        "contract_artifact_commit"
      ]
    },
    {
      "name": "runtime registration to execution",
      "context": "architecture-contracts",
      "nodes": [
        "contract_runtime_router",
        "contract_runtime_capability_catalog",
        "contract_prefect_deployment_spec",
        "contract_runtime_callable"
      ]
    },
    {
      "name": "backend dto to frontend feature",
      "context": "architecture-contracts",
      "nodes": [
        "contract_backend_transport_dto",
        "contract_openapi",
        "contract_generated_web_client",
        "contract_frontend_feature_consumer"
      ]
    },
    {
      "name": "sc images to ml lifecycle",
      "context": "architecture-contracts",
      "nodes": [
        "context_sc_domain",
        "contract_protobuf",
        "contract_image_parser",
        "context_ml_lifecycle"
      ]
    },
    {
      "name": "source admission to collection snapshot",
      "context": "architecture-contracts",
      "nodes": [
        "context_ingestion_automation",
        "contract_source_admission",
        "contract_collection_snapshot"
      ]
    }
  ],
  "global_excludes": [
    "**/.git/**",
    "**/.venv/**",
    "**/__pycache__/**",
    "**/.pytest_cache/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/tmp/**",
    "**/graphify-out/**",
    "**/.DS_Store",
    "**/*.bak"
  ],
  "base_excludes": [
    "**/tests/**",
    "**/test_*.py",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.design.vue",
    "**/generated/**",
    "**/migrations/**",
    "**/alembic/**",
    "**/fixtures/**"
  ],
  "contexts": [
    {
      "name": "architecture-contracts",
      "description": "Cross-context ports, composition, registries, transports, and architecture decisions.",
      "aliases": [
        "architecture",
        "contract",
        "composition",
        "dependency injection",
        "openapi",
        "protobuf",
        "data plane",
        "runtime registration"
      ],
      "roots": [
        "apps/api/app/modules/runtime",
        "apps/api/app/shared/application",
        "apps/api/app/shared/domain",
        "apps/api/app/shared/sse",
        "apps/web/src/shared/widgets"
      ],
      "include_globs": [
        "apps/api/app/composition.py",
        "apps/api/app/sc_data_provider_composition.py",
        "apps/api/app/registrations.py",
        "apps/api/app/core/*registry*.py",
        "apps/api/app/modules/registry.py",
        "apps/api/app/modules/*/container.py",
        "apps/api/app/modules/*/port/local/**/*.py",
        "apps/api/app/modules/*/domain/*registry*.py",
        "apps/api/app/shared/context.py",
        "apps/web/src/app/registrations.ts",
        "apps/web/src/features/datasets/presentation/pages/registry.ts",
        "apps/web/src/features/datasets/presentation/pages/schema-registry.ts"
