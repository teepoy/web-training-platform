        "apps/api/app/modules/datasets",
        "apps/api/app/modules/storage",
        "apps/api/app/modules/dataset_collections",
        "apps/web/src/features/datasets",
        "apps/web/src/features/library",
        "apps/web/src/features/dataset-collections"
