      "max_source_files": 280,
      "max_nodes": 5000,
      "overlays": {
        "generated-contracts": {
          "include_globs": [
            "apps/web/src/generated/orval/models/artifactRef.ts",
            "apps/web/src/generated/orval/models/automationRunOverviewResponse.ts",
            "apps/web/src/generated/orval/models/createTrainingJobRequest.ts",
            "apps/web/src/generated/orval/models/dataset.ts",
            "apps/web/src/generated/orval/models/datasetCollectionResponse.ts",
            "apps/web/src/generated/orval/models/datasetCollectionRevisionResponse.ts",
            "apps/web/src/generated/orval/models/datasetRevisionResponse.ts",
            "apps/web/src/generated/orval/models/predictionJobResponse.ts",
            "apps/web/src/generated/orval/models/runPredictionRequest.ts",
            "apps/web/src/generated/orval/models/trainingJob.ts",
            "apps/web/src/features/sc/generated/proto/**/*.ts",
            "libs/protos/src/proto_stubs/imageparser/v1/service_pb2.py",
            "libs/protos/src/proto_stubs/imageparser/v1/service_pb2_grpc.py",
            "libs/protos/src/proto_stubs/sc/v1/sample_pb2.py",
            "libs/protos/src/proto_stubs/sc/v1/upstream_pb2.py",
            "libs/protos/src/proto_stubs/sc/v1/upstream_pb2_grpc.py"
          ]
        },
        "tests": {
          "include_globs": [
            "apps/api/app/modules/runtime/tests/**/*.py",
            "apps/web/src/shared/widgets/**/*.spec.ts"
          ]
        }
      }
    },
    {
      "name": "data-resources",
