{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "generate:orval": "orval --config orval.config.ts",
    "test:unit": "vitest run",
    "test:e2e": "PLAYWRIGHT_MODE=mock playwright test -c e2e/playwright.config.ts --project=mock",
    "test:e2e:ui": "PLAYWRIGHT_MODE=mock playwright test -c e2e/playwright.config.ts --project=mock --ui",
    "test:e2e:live": "PLAYWRIGHT_MODE=live playwright test -c e2e/playwright.config.ts --project=live --workers=1",
    "test:e2e:live:ui": "PLAYWRIGHT_MODE=live playwright test -c e2e/playwright.config.ts --project=live --workers=1 --ui",
    "test:e2e:smoke": "PLAYWRIGHT_MODE=mock playwright test -c e2e/playwright.config.ts --project=mock --grep @smoke",
    "test:e2e:report": "playwright show-report e2e/.artifacts/report/mock",
    "test:e2e:live:report": "playwright show-report e2e/.artifacts/report/live",
    "test": "pnpm test:unit && pnpm test:e2e",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:proto": "cd ../.. && make generate-protos"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@platform/sc-map-element": "workspace:*",
    "@tanstack/vue-query": "^5.66.9",
    "@tanstack/vue-table": "^8.21.3",
    "@tanstack/vue-virtual": "^3.13.23",
    "@vicons/ionicons5": "^0.13.0",
    "@vue-dnd-kit/core": "^2.4.4",
    "@vueuse/core": "^14.3.0",
    "apache-arrow": "^21.1.0",
    "echarts": "^6.0.0",
    "kdbush": "^4.0.2",
    "marked": "^18.0.5",
    "naive-ui": "^2.44.1",
    "pinia": "^3.0.1",
    "unplugin-vue-components": "^32.0.0",
    "vue": "^3.5.13",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.5.0",
    "vxe-pc-ui": "^4.15.14",
    "vxe-table": "^4.19.21"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.12.0",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/addon-interactions": "8.6.18",
    "@storybook/test": "8.6.18",
    "@storybook/vue3": "8.6.18",
    "@storybook/vue3-vite": "^8.6.18",
    "@types/node": "^22.13.1",
    "@vitejs/plugin-legacy": "^8.0.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.10",
    "happy-dom": "^20.9.0",
    "katex": "^0.16.44",
    "msw": "^2.14.6",
    "orval": "7.5.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "storybook": "^8.6.18",
    "tsup": "^8.5.1",
    "typescript": "~5.7.3",
    "vite": "^6.4.1",
    "vitest": "^4.1.2",
    "vue-tsc": "^2.2.4"
  }
}
