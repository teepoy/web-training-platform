{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test:widgets": "vitest run src/components/classify/widget*.spec.ts src/composables/*.spec.ts",
    "test:plugins": "vitest run src/plugins/*.spec.ts src/plugins/**/*.spec.ts",
    "test:all": "vitest run src/**/*.spec.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e-live": "playwright test --config e2e-live/playwright.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@platform/plugin-sdk": "workspace:*",
    "@platform/web-ui": "workspace:*",
    "@tanstack/vue-query": "^5.66.9",
    "@tanstack/vue-table": "^8.21.3",
    "@tanstack/vue-virtual": "^3.13.23",
    "@vue-dnd-kit/core": "^2.4.4",
    "echarts": "^6.0.0",
    "kdbush": "^4.0.2",
    "naive-ui": "^2.44.1",
    "pinia": "^3.0.1",
    "unplugin-vue-components": "^32.0.0",
    "vue": "^3.5.13",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/addon-interactions": "8.6.18",
    "@storybook/test": "8.6.18",
    "@storybook/vue3": "8.6.18",
    "@storybook/vue3-vite": "^8.6.18",
    "@types/node": "^22.13.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "katex": "^0.16.44",
    "storybook": "^8.6.18",
    "tsup": "^8.5.1",
    "typescript": "~5.7.3",
    "vite": "^6.4.1",
    "vitest": "^4.1.2",
    "vue-tsc": "^2.2.4"
  }
}
