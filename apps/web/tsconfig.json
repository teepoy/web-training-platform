{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@platform/widget-sdk": ["../../libs/widget-sdk/src/index.ts"],
      "@platform/web-ui": ["../../libs/web-ui/src/index.ts"],
      "@platform/web-ui/*": ["../../libs/web-ui/src/*"],
      "@platform/web-data": ["../../libs/web-ui/src/api/index.ts"],
      "@platform/web-data/*": ["../../libs/web-ui/src/api/*"]
    },
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "src/**/*.vue"]
}
