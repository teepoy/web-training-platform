FROM python:3.12-slim AS base

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

ARG UV_INDEX_URL=""
ARG PIP_INDEX_URL=""

WORKDIR /app

ENV UV_INDEX_URL=${UV_INDEX_URL}
ENV PIP_INDEX_URL=${PIP_INDEX_URL}

COPY pyproject.toml uv.lock ./
COPY apps/api/pyproject.toml apps/api/pyproject.toml
COPY libs/ml/pyproject.toml libs/ml/pyproject.toml
COPY libs/platform-runtime/pyproject.toml libs/platform-runtime/pyproject.toml
COPY libs/python-sdk/pyproject.toml libs/python-sdk/pyproject.toml
COPY libs/seedmaker/pyproject.toml libs/seedmaker/pyproject.toml
COPY libs/protos/pyproject.toml libs/protos/pyproject.toml

# Full protos source needed to build proto-stubs workspace member
COPY libs/protos/ libs/protos/
COPY infra/compose/prefect.yaml prefect.yaml

FROM base AS deps

# ── Phase 1: install dependencies (layers cached until pyproject.toml changes) ──
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --package finetune-api --no-dev --no-install-workspace

# ── Phase 2: copy application source and install the package itself ──
COPY apps/api/ apps/api/
COPY libs/ml/ libs/ml/
COPY libs/platform-runtime/ libs/platform-runtime/
COPY libs/seedmaker/ libs/seedmaker/

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --package finetune-api --no-dev

FROM deps AS dev

WORKDIR /app

ENTRYPOINT ["uv", "run", "--no-dev", "--directory", "apps/api", "prefect", "worker", "start", "--pool", "default-cpu"]

FROM deps AS prod

ENTRYPOINT ["uv", "run", "--no-dev", "--directory", "apps/api", "prefect", "worker", "start", "--pool", "default-cpu"]
