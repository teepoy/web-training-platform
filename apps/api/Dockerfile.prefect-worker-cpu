FROM python:3.12-slim AS base

COPY --from=ghcr.io/astral-sh/uv:0.11.22 /uv /uvx /usr/local/bin/

ARG UV_INDEX_URL=""
ARG PIP_INDEX_URL=""

WORKDIR /app

ENV UV_INDEX_URL=${UV_INDEX_URL}
ENV PIP_INDEX_URL=${PIP_INDEX_URL}

COPY pyproject.toml uv.lock ./
COPY apps/api/pyproject.toml apps/api/pyproject.toml
COPY libs/protos/pyproject.toml libs/protos/pyproject.toml
COPY libs/ml/pyproject.toml libs/ml/pyproject.toml
COPY services/sc-upstream/pyproject.toml services/sc-upstream/pyproject.toml

# Full protos source needed to build proto-stubs workspace member
COPY libs/protos/ libs/protos/
COPY infra/compose/prefect.yaml prefect.yaml

FROM base AS deps

# ── Phase 1: install dependencies (layers cached until pyproject.toml changes) ──
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --package finetune-api --no-dev --no-install-workspace

# ── Phase 2: copy application source and install the package itself ──
COPY apps/api/ apps/api/

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --package finetune-api --no-dev

FROM deps AS dev

WORKDIR /app

ENTRYPOINT ["/bin/sh", "-lc", "exec /app/.venv/bin/prefect worker start --pool default-cpu --limit ${PREFECT_WORKER_LIMIT:-2}"]

FROM deps AS prod

WORKDIR /app

ENTRYPOINT ["/bin/sh", "-lc", "exec /app/.venv/bin/prefect worker start --pool default-cpu --limit ${PREFECT_WORKER_LIMIT:-2}"]
